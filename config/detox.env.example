# Окружение для systemd-сервиса сбора (скопируй в config/detox.env и заполни).
# config/detox.env — под .gitignore (там креды), НЕ коммитить.

# Бинарь yt-dlp с плагином PO-токена (pipx-путь). Проверь: which -a yt-dlp
YTDLP_BIN=/home/xtrbase/.local/bin/yt-dlp

# Креды объектного хранилища (dev MinIO — minioadmin/minioadmin; в проде — реальные).
# Нужны, т.к. [storage] backend = "s3" пишет Bronze в MinIO.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Уровень логов (info достаточно; debug — для диагностики).
RUST_LOG=info
