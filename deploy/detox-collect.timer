[Unit]
Description=detox-parser: периодический инкрементальный сбор
# systemd не запускает второй экземпляр того же сервиса, пока предыдущий идёт —
# если прогон затянулся, следующий стартует через OnUnitActiveSec после финиша.

[Timer]
# Первый прогон — через 5 мин после старта таймера (даём docker подняться).
OnBootSec=5min
# Дальше — каждые 6 часов от завершения предыдущего прогона.
OnUnitActiveSec=6h
# Пропущенные из-за выключенного сервера прогоны — догнать при следующем старте.
Persistent=true
Unit=detox-collect.service

[Install]
WantedBy=timers.target
